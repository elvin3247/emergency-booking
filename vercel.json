{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/admin?job=daily",
      "schedule": "0 11 * * *"
    }
  ],
  "functions": {
    "api/admin.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/hvac/:county(.+)-county-nj",
      "destination": "/hvac/new-jersey#:county-county",
      "permanent": true
    },
    {
      "source": "/plumbing/:county(.+)-county-nj",
      "destination": "/plumbing/new-jersey#:county-county",
      "permanent": true
    },
    {
      "source": "/water-heater/:county(.+)-county-nj",
      "destination": "/water-heater/new-jersey#:county-county",
      "permanent": true
    }
  ]
}
