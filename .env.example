# Copy these into Vercel > Project > Settings > Environment Variables.
SITE_URL=https://your-project.vercel.app
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=           # server only, never put this in public/
RESEND_API_KEY=
FROM_EMAIL=YourBrand <alerts@yourdomain.com>   # must be a domain verified in Resend
ADMIN_EMAIL=you@example.com                    # gets every new request, match, and sign-up

# The key you type into /admin. Make it long and random. Without it the admin page stays locked.
ADMIN_KEY=

# Lets Vercel's daily schedule run the daily job (review reminders, closed-request emails, your morning summary,
# photo cleanup, and keeping Supabase awake). Any long random value.
CRON_SECRET=

# Your business postal address, required by law (CAN-SPAM) in recruiting emails to companies that haven't signed up.
# Bulk invites stay off until it's set. A PO box works. (Or set mailingAddress in public/assets/config.js.)
MAILING_ADDRESS=

# Text alerts for pros (optional). Texting stays off until all three are set. Register for business texting
# in Twilio first (10DLC or toll-free verification); carriers block unregistered senders.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=                  # preferred. Or TWILIO_FROM=+19085550100 for a single number
